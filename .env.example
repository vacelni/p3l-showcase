# Copy to .env.local (never committed).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# /admin login (at least 16 characters) and a long random string to sign sessions
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Absolute URL of this deployment (canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: e-invoice email (Resend), new-registration notices (comma-separated)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# Optional: Cloudflare Turnstile bot check (enabled only when both are set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Search Console HTML-tag verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
